# .env.example
# Names only. Never commit production secret values.
#
# Classification:
# - [PUBLIC] may be exposed to Astro/browser code. Only PUBLIC_* names belong here.
# - [BUILD] build/deploy configuration; not a secret unless explicitly stated.
# - [WORKER] Worker-only runtime configuration; must not be exposed to browser bundles.
# - [SECRET] Worker/deploy secret. Configure through Cloudflare secret storage / CI secret store, never commit a value.
# - [OPTIONAL] unset unless the feature is explicitly enabled.
#
# tragarze.pl origins below are expected/provisional project defaults.
# They are NOT final DNS confirmation. Q001 in docs/OPEN_QUESTIONS.md remains authoritative until resolved.

# Project / build
PROJECT=tragarze
SITE_ID=tragarze-pl
APP_ENV=development

# Astro public [PUBLIC]
PUBLIC_SITE_URL=https://tragarze.pl
PUBLIC_API_URL=https://api.tragarze.pl
PUBLIC_DEFAULT_LOCALE=pl
PUBLIC_TURNSTILE_SITE_KEY=

# Discovery [BUILD/WORKER]
POPULARITY_WINDOW_DAYS=7

# Cloudflare / D1 [BUILD/WORKER]
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_DATABASE_NAME=

# Turnstile [SECRET]
# Canonical secret env name for this project:
TURNSTILE_SECRET_KEY=

# Cloudflare Access / admin [WORKER]
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Runtime security / limits [WORKER]
# Provisional until final DNS confirmation (Q001).
ALLOWED_ORIGIN=https://tragarze.pl
VISITOR_COOKIE_NAME=tragarze_vid
READ_DEDUP_WINDOW_SECONDS=
RATE_LIMIT_READS=
RATE_LIMIT_COMMENTS=
RATE_LIMIT_RATINGS=

# Optional observability [WORKER][OPTIONAL]
LOG_LEVEL=info

# Optional integrations [OPTIONAL]
# Keep disabled/unset until explicitly adopted.
ANALYTICS_ID=
