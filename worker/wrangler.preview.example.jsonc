{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "REPLACE_WITH_PREVIEW_WORKER_NAME",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "preview",
    "SITE_ID": "tragarze-pl",
    "ALLOWED_ORIGIN": "REPLACE_WITH_PREVIEW_SITE_ORIGIN",
    "POPULARITY_WINDOW_DAYS": "7",
    "VISITOR_COOKIE_NAME": "tragarze_vid",
    "LOG_LEVEL": "info"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "REPLACE_WITH_PREVIEW_D1_NAME", "database_id": "REPLACE_WITH_PREVIEW_D1_ID", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "READ_RATE_LIMITER", "namespace_id": "REPLACE_WITH_PREVIEW_READ_NAMESPACE", "simple": { "limit": 6, "period": 60 } },
    { "name": "COMMENT_CREATE_RATE_LIMITER", "namespace_id": "REPLACE_WITH_PREVIEW_COMMENT_CREATE_NAMESPACE", "simple": { "limit": 3, "period": 60 } },
    { "name": "COMMENT_FEEDBACK_RATE_LIMITER", "namespace_id": "REPLACE_WITH_PREVIEW_COMMENT_FEEDBACK_NAMESPACE", "simple": { "limit": 12, "period": 60 } },
    { "name": "RATING_RATE_LIMITER", "namespace_id": "REPLACE_WITH_PREVIEW_RATING_NAMESPACE", "simple": { "limit": 6, "period": 60 } }
  ]
}
