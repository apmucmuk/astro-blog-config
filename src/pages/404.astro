---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { seoMetadata } from "@core/seo/metadata";
import { navigation } from "@project/navigation";
import { projectConfig } from "@project/site.config";

const metadata = seoMetadata({
  title: "Nie znaleziono strony - tragarze.pl",
  description: "Ta strona nie istnieje albo została przeniesiona.",
  pathname: "/404/",
  siteUrl: projectConfig.siteUrl,
  noindex: true,
});
---

<BaseLayout title={metadata.title} description={metadata.description} locale={projectConfig.locale} siteName={projectConfig.name} navigation={navigation}>
  <Fragment slot="head">
    <meta name="description" content={metadata.description} />
    <meta name="robots" content="noindex,follow" />
  </Fragment>
  <section class="hero">
    <div class="hero__inner container">
      <h1>Nie znaleziono strony</h1>
      <p class="lede">Sprawdź adres albo wróć do strony głównej.</p>
      <a href="/">Strona główna</a>
    </div>
  </section>
</BaseLayout>
