---
import { getCollection } from "astro:content";
import { filterPublished } from "@core/content/lifecycle";
import { articleCanonical } from "@core/seo/hreflang";
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { projectConfig } from "@project/site.config";
import { routeSegments } from "@project/routing.config";
import { navigation } from "@project/navigation";
import categories from "../../content/data/categories.json";
const articles = filterPublished(await getCollection("blog")).sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime() || a.data.id.localeCompare(b.data.id));
const articleUrl = (article: typeof articles[number]) => articleCanonical({
  locale: article.data.locale, segments: routeSegments, siteUrl: projectConfig.siteUrl,
  categorySlug: categories.find((category) => category.id === article.data.category)!.slug,
  articleSlug: article.data.slug,
});
---
<BaseLayout title={`Blog - ${projectConfig.name}`} locale={projectConfig.locale} siteName={projectConfig.name} navigation={navigation}>
  <Fragment slot="head">
    <meta name="description" content="Poradniki o przygotowaniu i organizacji przeprowadzki." />
    <link rel="canonical" href={new URL("/blog/", projectConfig.siteUrl)} />
  </Fragment>
  <section class="container" data-stats-batch data-api-url={projectConfig.apiUrl}>
    <h1>Blog</h1>
    <label>Sortowanie <select data-stats-sort disabled>
      <option value="newest">Najnowsze</option>
      <option value="popularNow">Popularne teraz</option>
      <option value="rating">Najwyżej oceniane</option>
      <option value="comments">Najwięcej komentarzy</option>
    </select></label>
    <ul data-stats-list aria-live="polite">
      {articles.map((article) => <li data-stats-id={article.data.id}>
        <h2><a href={articleUrl(article)}>{article.data.title}</a></h2>
        <p>{article.data.description}</p>
        <p hidden>Czytelnicy: <span data-reads></span></p>
      </li>)}
    </ul>
  </section>
</BaseLayout>
<script>
  import { enhanceStats } from "@features/stats/listing";
  document.querySelectorAll<HTMLElement>("[data-stats-batch]").forEach((element) => { void enhanceStats(element); });
</script>
