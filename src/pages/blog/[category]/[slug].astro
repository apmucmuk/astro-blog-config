---
import { getCollection, render } from "astro:content";
import { filterPublished, isSearchIndexable } from "@core/content/lifecycle";
import { articleCanonical, hreflangLinks } from "@core/seo/hreflang";
import { blogPostingJsonLd, breadcrumbJsonLd, seoMetadata } from "@core/seo/metadata";
import { personPath } from "@core/routing/routes";
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { navigation } from "@project/navigation";
import { projectConfig } from "@project/site.config";
import { routeSegments } from "@project/routing.config";
import { runtimeConfig } from "@project/runtime.config";
import categories from "../../../content/data/categories.json";

export async function getStaticPaths() {
  const articles = filterPublished(await getCollection("blog"));
  const people = await getCollection("people");

  return articles.map((article) => {
    const category = categories.find((item) => item.id === article.data.category);
    if (!category) {
      throw new Error(`Unknown category '${article.data.category}' for article '${article.id}'.`);
    }

    return {
      params: {
        category: category.slug,
        slug: article.data.slug,
      },
      props: {
        article,
        articles,
        category,
        people,
      },
    };
  });
}

const { article, articles, category, people } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
const searchIndexable = isSearchIndexable(article);
const { Content } = await render(article);
const canonical = articleCanonical({
  locale: article.data.locale,
  segments: routeSegments,
  categorySlug: category.slug,
  articleSlug: article.data.slug,
  siteUrl: projectConfig.siteUrl,
});
const translations = articles.filter(
  (candidate) => candidate.data.translationKey === article.data.translationKey,
);
const alternates = hreflangLinks(
  translations.map((translation) => {
    const translationCategory = categories.find((item) => item.id === translation.data.category);
    if (!translationCategory) {
      throw new Error(`Unknown category '${translation.data.category}' for article '${translation.id}'.`);
    }

    return {
      locale: translation.data.locale,
      segments: routeSegments,
      categorySlug: translationCategory.slug,
      articleSlug: translation.data.slug,
      siteUrl: projectConfig.siteUrl,
    };
  }),
);
const metadata = seoMetadata({
  title: article.data.seoTitle ?? article.data.title,
  description: article.data.description,
  pathname: new URL(canonical).pathname,
  siteUrl: projectConfig.siteUrl,
  noindex: article.data.noindex,
});
const authorProfiles = article.data.authors.map((authorId) => {
  const person = people.find((item) => item.data.id === authorId);
  if (!person) {
    throw new Error(`Unknown author '${authorId}' for article '${article.id}'.`);
  }

  const profileUrl = new URL(
    personPath({ segments: routeSegments, personSlug: person.data.slug }),
    projectConfig.siteUrl,
  ).toString();

  return { name: person.data.name, url: profileUrl };
});
const breadcrumbs = [
  { name: "Strona główna", url: projectConfig.siteUrl },
  { name: "Blog", url: new URL("/blog/", projectConfig.siteUrl).toString() },
  { name: category.name, url: new URL(`/blog/${category.slug}/`, projectConfig.siteUrl).toString() },
  { name: article.data.title, url: canonical },
];
const jsonLd = [
  breadcrumbJsonLd(breadcrumbs),
  blogPostingJsonLd({
    headline: article.data.title,
    description: article.data.description,
    url: canonical,
    datePublished: article.data.publishDate.toISOString(),
    dateModified: article.data.updatedDate?.toISOString(),
    author: authorProfiles,
    image: new URL(article.data.image.src, projectConfig.siteUrl).toString(),
  }),
];
---

<BaseLayout title={metadata.title} description={metadata.description} locale={article.data.locale} siteName={projectConfig.name} navigation={navigation}>
  <Fragment slot="head">
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonical} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    <link rel="alternate" hreflang="x-default" href={metadata.canonical} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </Fragment>
  <article data-stats-batch data-api-url={projectConfig.apiUrl} data-pagefind-body={searchIndexable ? true : undefined} data-pagefind-ignore={searchIndexable ? undefined : true}>
    <header class="article-header article-container">
      <nav class="breadcrumb" aria-label="Breadcrumbs">
        {breadcrumbs.map((item, index) => (
          <a href={item.url}>{item.name}{index < breadcrumbs.length - 1 ? " / " : ""}</a>
        ))}
      </nav>
      <p class="eyebrow">{category.name}</p>
      <div class="article-meta">
        {authorProfiles.map((author) => <a href={author.url}>{author.name}</a>)}
        <time datetime={article.data.publishDate.toISOString()}>{article.data.publishDate.toLocaleDateString("pl-PL")}</time>
      </div>
      <p data-stats-id={article.data.id}><span hidden>Czytelnicy: <span data-reads></span></span></p>
      <div class="hero__inner">
        <h1 data-pagefind-meta="title">{article.data.title}</h1>
        <p class="lede" data-pagefind-meta="description">{article.data.description}</p>
      </div>
      <img
        class="article-hero"
        src={article.data.image.src}
        alt={article.data.image.alt}
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
      />
    </header>
    <div class="article-body article-container" data-read-article data-site-id={projectConfig.siteId} data-article-id={article.data.id} data-api-url={projectConfig.apiUrl} data-dedup-seconds={runtimeConfig.readDedupWindowSeconds}>
        <Content />
    </div>
    <section class="comment-form article-container" aria-labelledby="comment-title">
      <h2 id="comment-title">Dodaj komentarz</h2>
      <form data-comment-form data-api-url={projectConfig.apiUrl} data-article-id={article.data.id} data-turnstile-site-key={turnstileSiteKey}>
        <label>Imię <input name="name" required maxlength="40" autocomplete="name" /></label>
        <label>Komentarz <textarea name="body" required maxlength="1500" rows="5"></textarea></label>
        <div data-turnstile-widget></div>
        <p data-comment-status role="status" aria-live="polite"></p>
        <button type="submit">Wyślij komentarz</button>
      </form>
    </section>
  </article>
</BaseLayout>
<script>
  import { mountReadDetector } from "@features/reads/detector";
  import { enhanceStats } from "@features/stats/listing";
  import { mountCommentForm } from "@features/comments/form";
  document.querySelectorAll<HTMLElement>("[data-read-article]").forEach(mountReadDetector);
  document.querySelectorAll<HTMLElement>("[data-stats-batch]").forEach((element) => { void enhanceStats(element); });
  document.querySelectorAll<HTMLFormElement>("[data-comment-form]").forEach(mountCommentForm);
</script>
