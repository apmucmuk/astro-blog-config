---
import { getCollection } from "astro:content";
import { filterPublished } from "@core/content/lifecycle";
import { breadcrumbJsonLd, personProfileJsonLd, seoMetadata } from "@core/seo/metadata";
import { personPath } from "@core/routing/routes";
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { navigation } from "@project/navigation";
import { projectConfig } from "@project/site.config";
import { routeSegments } from "@project/routing.config";
import { buildListing, listingPageSize } from "@project/listing";
import { collectionPage } from "@features/stats/collection";
import ListingSurface from "@project/ListingSurface.astro";

export async function getStaticPaths() {
  const people = await getCollection("people");
  const articles = filterPublished(await getCollection("blog"));

  return people.map((person) => ({
    params: { person: person.data.slug },
    props: {
      person,
      authoredArticles: articles.filter((article) => article.data.authors.includes(person.data.id)),
      contributedArticles: articles.filter((article) =>
        article.data.contributors.some((contributor) => contributor.person === person.data.id),
      ),
    },
  }));
}

const { person, authoredArticles, contributedArticles } = Astro.props;
const { entries, manifestUrl } = await buildListing();
const pathname = personPath({ segments: routeSegments, personSlug: person.data.slug });
const base = `${pathname}/`;
const authored = collectionPage(entries, "newest", 1, listingPageSize, projectConfig.locale, null, (entry) => entry.authors.includes(person.data.id));
const metadata = seoMetadata({
  title: `${person.data.name} - redakcja tragarze.pl`,
  description: person.data.bioShort,
  pathname,
  siteUrl: projectConfig.siteUrl,
  noindex: person.data.noindex,
});
const breadcrumbs = [
  { name: "Strona główna", url: projectConfig.siteUrl },
  { name: "Redakcja", url: new URL("/redakcja/", projectConfig.siteUrl).toString() },
  { name: person.data.name, url: metadata.canonical },
];
const jsonLd = [
  breadcrumbJsonLd(breadcrumbs),
  personProfileJsonLd({
    name: person.data.name,
    description: person.data.bioShort,
    url: metadata.canonical,
  }),
];
---

<BaseLayout title={metadata.title} description={metadata.description} locale={person.data.locale} siteName={projectConfig.name} navigation={navigation}>
  <Fragment slot="head">
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonical} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </Fragment>
  <section class="profile container">
    <nav class="breadcrumb" aria-label="Breadcrumbs">
        {breadcrumbs.map((item, index) => <a href={item.url}>{item.name}{index < breadcrumbs.length - 1 ? " / " : ""}</a>)}
      </nav>
    <header class="hero__inner">
      <h1>{person.data.name}</h1>
      <p class="lede">{person.data.headline}</p>
      <p>{person.data.bio}</p>
    </header>
    <div class="card-grid">
      {authoredArticles.length > 0 && (
        <section class="card">
          <h2>Publikacje autora</h2>
          <ListingSurface {base} items={authored.items} total={authored.total} page={1} {manifestUrl} person={person.data.id} allowedSorts={["newest", "popular", "comments", "updated"]} />
        </section>
      )}
      {contributedArticles.length > 0 && (
        <section class="card">
          <h2>Redakcja i weryfikacja</h2>
          <ul>{contributedArticles.map((article) => <li>{article.data.title}</li>)}</ul>
        </section>
      )}
    </div>
  </section>
</BaseLayout>
<script>
  import { enhanceStats } from "@features/stats/listing";
  document.querySelectorAll<HTMLElement>("[data-stats-batch]").forEach((element) => { void enhanceStats(element); });
</script>
