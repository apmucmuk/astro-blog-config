---
import { getCollection } from "astro:content";
import { breadcrumbJsonLd, personProfileJsonLd, seoMetadata } from "@core/seo/metadata";
import { personPath } from "@core/routing/routes";
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { navigation } from "@project/navigation";
import { projectConfig } from "@project/site.config";
import { routeSegments } from "@project/routing.config";

const people = (await getCollection("people")).sort((a, b) => b.data.rank - a.data.rank);
const metadata = seoMetadata({
  title: "Redakcja tragarze.pl",
  description: "Poznaj redakcję i autorów publikacji tragarze.pl.",
  pathname: "/redakcja/",
  siteUrl: projectConfig.siteUrl,
});
const breadcrumbs = [
  { name: "Strona główna", url: projectConfig.siteUrl },
  { name: "Redakcja", url: metadata.canonical },
];
const jsonLd = [
  breadcrumbJsonLd(breadcrumbs),
  ...people.map((person) =>
    personProfileJsonLd({
      name: person.data.name,
      description: person.data.bioShort,
      url: new URL(
        personPath({ segments: routeSegments, personSlug: person.data.slug }),
        projectConfig.siteUrl,
      ).toString(),
    }),
  ),
];
---

<BaseLayout title={metadata.title} description={metadata.description} locale={projectConfig.locale} siteName={projectConfig.name} navigation={navigation}>
  <Fragment slot="head">
    <meta name="description" content={metadata.description} />
    <meta name="robots" content={metadata.robots} />
    <link rel="canonical" href={metadata.canonical} />
    {jsonLd.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </Fragment>
  <section class="hero">
    <div class="hero__inner container">
      <nav class="breadcrumb" aria-label="Breadcrumbs">
        {breadcrumbs.map((item, index) => <a href={item.url}>{item.name}{index < breadcrumbs.length - 1 ? " / " : ""}</a>)}
      </nav>
      <h1>Redakcja tragarze.pl</h1>
      <p class="lede">Opisujemy, jak przygotować przeprowadzkę, zabezpieczyć rzeczy i lepiej zaplanować pracę tragarzy.</p>
    </div>
  </section>
  <section class="page-section container">
    <div class="card-grid">
      <article class="card">
        <h2>Jak tworzymy materiały</h2>
        <p>Publikacje powstają na podstawie praktycznych scenariuszy przeprowadzek i są porządkowane przez redakcję.</p>
      </article>
      <section>
        <h2>Autorzy</h2>
        <ul>
          {people.map((person) => (
            <li>
              <a href={personPath({ segments: routeSegments, personSlug: person.data.slug })}>{person.data.name}</a>
              <p>{person.data.headline}</p>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </section>
</BaseLayout>
