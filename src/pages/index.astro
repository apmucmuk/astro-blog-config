---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { projectConfig } from "@project/index";
import { navigation } from "@project/navigation";
---

<BaseLayout title={projectConfig.name} locale={projectConfig.locale} siteName={projectConfig.name} navigation={navigation}>
  <section class="hero">
    <div class="hero__inner container">
      <h1>{projectConfig.name}</h1>
      <p class="lede">Praktyczne poradniki i redakcyjny fundament serwisu o przeprowadzkach.</p>
    </div>
  </section>
</BaseLayout>
