---
import { breadcrumbJsonLd, seoMetadata } from "@core/seo/metadata";
import { navigation } from "@project/navigation";
import { projectConfig } from "@project/site.config";
import BaseLayout from "@theme/layouts/BaseLayout.astro";

const metadata = seoMetadata({
  title: "Narzędzia | tragarze.pl",
  description: "Narzędzia pomocne w planowaniu przeprowadzki będą publikowane w tym dziale.",
  pathname: "/narzedzia/",
  siteUrl: projectConfig.siteUrl,
});
const breadcrumbs = [
  { name: "Strona główna", url: projectConfig.siteUrl },
  { name: "Narzędzia", url: metadata.canonical },
];
---

<BaseLayout title={metadata.title} description={metadata.description} locale={projectConfig.locale} siteName={projectConfig.name} navigation={navigation} canonical={metadata.canonical} robots={metadata.robots}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd(breadcrumbs))} />
  </Fragment>
  <section class="hero">
    <div class="hero__inner container">
      <nav class="breadcrumb" aria-label="Breadcrumbs">
        {breadcrumbs.map((item, index) => <a href={item.url}>{item.name}{index < breadcrumbs.length - 1 ? " / " : ""}</a>)}
      </nav>
      <h1>Narzędzia</h1>
      <p class="lede">W tym dziale będziemy publikować zatwierdzone narzędzia pomocne przy planowaniu przeprowadzki.</p>
    </div>
  </section>
  <section class="page-section container" aria-labelledby="tools-heading">
    <div class="card">
      <h2 id="tools-heading">Narzędzia w przygotowaniu</h2>
      <p>Obecnie nie ma jeszcze zatwierdzonych narzędzi do opublikowania.</p>
    </div>
  </section>
</BaseLayout>
