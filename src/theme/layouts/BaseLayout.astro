---
import "../styles/global.css";
import { defaultRobots } from "@core/seo/launch";

type Props = {
  title?: string;
  description?: string;
  locale: string;
  siteName: string;
  navigation: ReadonlyArray<{ label: string; href: string }>;
  socialImage?: string;
  socialImageAlt?: string;
  canonical?: string | false;
  robots?: string;
};

const {
  title,
  description,
  locale,
  siteName,
  navigation,
  socialImage = "/images/tragarze-default-og.png",
  socialImageAlt,
  canonical,
  robots = defaultRobots,
} = Astro.props;
const socialOrigin = import.meta.env.PUBLIC_SITE_URL ?? "https://tragarze.pl";
const canonicalUrl = canonical === false ? false : canonical ?? new URL(Astro.url.pathname, socialOrigin).toString();
const socialImageUrl = new URL(socialImage, socialOrigin).toString();
const pageTitle = title ?? siteName;
const pageDescription = description ?? siteName;
const pageSocialImageAlt = socialImageAlt ?? pageTitle;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline src="/scripts/theme.js"></script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robots} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageSocialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Przejdź do treści</a>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner container">
          <a class="brand" href="/"><img src="/images/tragarze-logo.svg" width="240" height="48" alt={siteName} /></a>
          <nav class="site-nav" aria-label="Główna nawigacja">
            {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
          </nav>
          <div class="theme-controls" role="group" aria-label="Motyw kolorystyczny">
            <button class="theme-control" type="button" data-theme-toggle aria-label="Zmień motyw" title="Zmień motyw">
              <span aria-hidden="true" data-theme-icon>☾</span><span class="sr-only" data-theme-toggle-label>Zmień motyw</span>
            </button>
            <button class="theme-control theme-control--system" type="button" data-theme-system aria-pressed="true" title="Użyj ustawienia systemowego">
              <span aria-hidden="true">System</span><span class="sr-only">Użyj ustawienia systemowego</span>
            </button>
          </div>
        </div>
      </header>
      <main id="main" class="site-main" tabindex="-1">
        <slot />
      </main>
      <footer class="site-footer">
        <div class="site-footer__inner container">
          <p>© {new Date().getFullYear()} {siteName}</p>
        </div>
      </footer>
    </div>
  </body>
</html>
