---
import BaseLayout from "@theme/layouts/BaseLayout.astro";
import { projectConfig } from "./site.config";
import { navigation } from "./navigation";
import { buildListing, listingPageSize } from "./listing";
import { collectionPage } from "@features/stats/collection";
import ListingSurface from "./ListingSurface.astro";
const { page = 1 } = Astro.props;
const { entries, manifestUrl } = await buildListing();
const { items, total } = collectionPage(entries, "newest", page, listingPageSize, projectConfig.locale);
---
<BaseLayout title={`Blog - ${projectConfig.name}`} description="Poradniki o przygotowaniu i organizacji przeprowadzki." locale={projectConfig.locale} siteName={projectConfig.name} navigation={navigation}>
  <section class="container page-section">
    <h1>Blog</h1>
    <ListingSurface base="/blog/" {items} {total} {page} {manifestUrl} allowedSorts={["newest", "popularNow", "rating", "comments", "updated"]} />
  </section>
</BaseLayout>
<script>
  import { enhanceStats } from "@features/stats/listing";
  document.querySelectorAll<HTMLElement>("[data-stats-batch]").forEach((element) => { void enhanceStats(element); });
</script>
